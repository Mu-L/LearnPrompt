---
import "../styles/docs-en.css";

interface Props {
  title: string;
  description: string;
  chineseHref: string;
}

const { title, description, chineseHref } = Astro.props;
const base = import.meta.env.BASE_URL === "/" ? "" : import.meta.env.BASE_URL.replace(/\/$/, "");
const withBase = (href: string) => (href.startsWith("/") ? `${base}${href}` : href);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | LearnPrompt</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <header class="lp-doc-header">
      <a class="lp-doc-brand" href={withBase("/en/")}>
        <strong>LearnPrompt</strong>
        <span>English preview</span>
      </a>
      <nav aria-label="English preview navigation">
        <a href={withBase("/en/start-here/")}>Start</a>
        <a href={withBase("/en/start-here/ai-practice-map/")}>Practice map</a>
        <a href={withBase("/en/start-here/context-task-verification/")}>Task contract</a>
        <a href={withBase(chineseHref)} lang="zh-CN">中文原文</a>
      </nav>
    </header>

    <main class="lp-doc-shell">
      <aside>
        <p>VERTICAL SLICE · 3 PAGES</p>
        <a href={withBase("/en/start-here/")}>01 · Start here</a>
        <a href={withBase("/en/start-here/ai-practice-map/")}>02 · AI practice map</a>
        <a href={withBase("/en/start-here/context-task-verification/")}>03 · Task contract</a>
      </aside>
      <article>
        <p class="lp-doc-kicker">LEARNPROMPT · AI PRACTICE WIKI</p>
        <h1>{title}</h1>
        <p class="lp-doc-description">{description}</p>
        <slot />
      </article>
    </main>

    <footer>
      <span>English preview</span>
      <span>Chinese remains the complete root edition</span>
    </footer>
  </body>
</html>
