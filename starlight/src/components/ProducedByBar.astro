---
/**
 * Minimal "produced by" strip for the LearnPrompt fleet.
 * Renders above the page header/nav on every page — Starlight docs pages
 * (via the PageFrame override) and the three hand-built pages under
 * src/pages/ (index.astro, en/index.astro, skills.astro).
 *
 * Uses currentColor-based tinting instead of hardcoded colors so it drops
 * cleanly into both the dark cinematic homepage palette and the Starlight
 * light/dark docs theme without needing per-page overrides.
 */
export interface Props {
  lang?: "zh" | "en";
}

const { lang = "zh" } = Astro.props;
const isEnglish = lang === "en";
const label = isEnglish ? "Built by" : "出品";

const links = [
  { name: "GoodCase.ai", href: "https://goodcase.ai" },
  {
    name: "AI News Radar",
    href: "https://news.learnprompt.pro",
  },
  { name: "AI Map", href: "https://aimap.carlwow.com" },
];
---

<div class="lp-produced-by" style={`--lp-produced-by-height: 2.25rem`}>
  <div class="lp-produced-by-track">
    <span class="lp-produced-by-label">{label}</span>
    <span class="lp-produced-by-current">LearnPrompt</span>
    {
      links.map((link) => (
        <>
          <span class="lp-produced-by-sep" aria-hidden="true">
            ·
          </span>
          <a
            class="lp-produced-by-link"
            href={link.href}
            target="_blank"
            rel="noopener"
          >
            {link.name} <span aria-hidden="true">↗</span>
          </a>
        </>
      ))
    }
  </div>
</div>

<style>
  /* Fixed, single-line height so PageFrame.astro can push the Starlight
     fixed header down by an exact, known amount (--lp-produced-by-height).
     Content that doesn't fit scrolls horizontally instead of wrapping,
     which would otherwise make the bar's height unpredictable. */
  .lp-produced-by {
    display: flex;
    align-items: center;
    height: var(--lp-produced-by-height, 2.25rem);
    width: 100%;
    padding-inline: 1.5rem;
    color: color-mix(in srgb, currentColor 62%, transparent);
    background: color-mix(in srgb, currentColor 5%, transparent);
    border-bottom: 1px solid color-mix(in srgb, currentColor 14%, transparent);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .lp-produced-by::-webkit-scrollbar {
    display: none;
  }

  .lp-produced-by-track {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    white-space: nowrap;
    font-size: 0.75rem;
    line-height: 1;
    margin-inline: auto;
  }

  .lp-produced-by-label {
    opacity: 0.7;
  }

  .lp-produced-by-current {
    font-weight: 600;
    color: currentColor;
    opacity: 0.92;
  }

  .lp-produced-by-sep {
    opacity: 0.4;
  }

  .lp-produced-by-link {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, currentColor 30%, transparent);
  }

  .lp-produced-by-link:hover {
    color: currentColor;
    opacity: 1;
    border-bottom-color: currentColor;
  }
</style>
